// Cold CRM – Datenmodell
// Kontakt = eine Allianz-Agentur. Die Anruf-Pipeline (stage) ist getrennt
// vom Cold-Mail-Status (CampaignLead, kommt aus Instantly).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  NEU
  NICHT_ERREICHT
  WIEDERVORLAGE
  INTERESSE
  TERMIN
  GEWONNEN
  SPAETER
  VERLOREN
  UNGUELTIG
}

// Kunden-Pipeline: alles nach der Zusage
enum CustomerStage {
  VERTRAG       // Zusage, Vertrag versendet
  ONBOARDING    // unterschrieben, Setup (Produkte, Gebiet, Kampagnen)
  TEST          // Testpaket / erste Leads
  AKTIV         // laufender Kunde
  PAUSIERT
  GEKUENDIGT
}

enum LossReason {
  KEIN_BEDARF       // ausgelastet, braucht keine Kunden
  HAT_ANBIETER      // kauft schon Leads / arbeitet mit Agentur
  UEBER_ALLIANZ     // macht das über die Allianz
  ZU_TEUER          // Budget / Preis
  KEIN_INTERESSE
  SONSTIGES
}

enum ActivityType {
  ANRUF
  EMAIL
  NOTIZ
  STATUS
  COLD_MAIL
  LINKEDIN
  TERMIN
  IMPORT
}

enum TaskType {
  ANRUF
  NACHFASSEN
  UNTERLAGEN
  TERMIN
  SONSTIGES
}

model Contact {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  phone        String?
  fax          String?
  street       String?
  zip          String?
  city         String?
  ratingValue  Float?
  ratingCount  Int?
  openingHours String?
  url          String?
  description  String?

  // Ansprechpartner & Zusatzinfos (aus der Instantly-Mailingliste)
  salutation     String?
  firstName      String?
  lastName       String?
  leaderNames    String? // alle Inhaber/Geschäftsführer, kommagetrennt
  agencyType     String? // GENERAL / HAUPT
  teamSize       Int?
  potentialScore Int?
  facebookUrl    String?
  instagramUrl   String?
  xingUrl        String?
  linkedinUrl    String?

  // LinkedIn-Outreach (Waalaxy)
  linkedinStatus      String? // ANFRAGE_GESENDET, VERNETZT, NACHRICHT_GESENDET, GEANTWORTET
  linkedinRequestAt   DateTime?
  linkedinConnectedAt DateTime?
  linkedinMessageAt   DateTime?
  linkedinReplyAt     DateTime?
  linkedinList        String? // Waalaxy-Liste / Kampagne
  linkedinTags        String?

  stage         Stage       @default(NEU)
  lossReason    LossReason?
  competitor    String? // z.B. LEAD.NOW, Terminadler, Alkaio
  callAttempts  Int         @default(0)
  lastContactAt DateTime?
  legacyStatus  String? // Original-Status aus der Cold-Calling-Liste

  // Kunde (gesetzt ab Stufe Gewonnen)
  customerStage CustomerStage?
  products      String? // z.B. "PKV, TKV, Leben"
  monthlyValue  Int? // € pro Monat
  contractStart DateTime?
  customerSince DateTime?
  customerSource     String? // Akquise-Kanal: COLD_CALL, COLD_MAIL, LINKEDIN, META_ADS, EMPFEHLUNG, INBOUND, NETZWERK, SONSTIGES
  customerSourceNote String? // z.B. "Kampagne Allianz Okt" oder "Empfehlung von Hr. Müller"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  tasks      Task[]
  campaigns  CampaignLead[]
  emails     EmailMessage[]
  linkedinEvents LinkedInEvent[]
  meetings       Meeting[]

  @@index([stage])
  @@index([customerStage])
  @@index([linkedinStatus])
  @@index([zip])
  @@index([city])
}

model Activity {
  id         String       @id @default(cuid())
  contactId  String
  contact    Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       ActivityType
  outcome    String?
  note       String?
  occurredAt DateTime     @default(now())

  @@index([contactId, occurredAt])
}

model Task {
  id        String    @id @default(cuid())
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  type      TaskType  @default(SONSTIGES)
  note      String?
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([doneAt, dueAt])
  @@index([contactId])
}

model Campaign {
  id          String         @id @default(cuid())
  instantlyId String?        @unique
  name        String         @unique
  createdAt   DateTime       @default(now())
  leads       CampaignLead[]
}

// Ein Kontakt in einer Instantly-Kampagne.
model CampaignLead {
  id           String    @id @default(cuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       String? // Aktiv, Pausiert, Abgeschlossen, Bounced, Abgemeldet, Übersprungen, Noch nicht kontaktiert
  sentAt       DateTime? // erste/letzte bekannte Mail
  openCount    Int       @default(0)
  replyCount   Int       @default(0)
  clickCount   Int       @default(0)
  lastOpenAt   DateTime?
  lastReplyAt  DateTime?
  bounced      Boolean   @default(false)
  unsubscribed Boolean   @default(false)
  interest     String? // Instantly-Interessenstatus
  updatedAt    DateTime  @updatedAt

  @@unique([contactId, campaignId])
  @@index([campaignId])
}

// E-Mails aus Instantly (v.a. Antworten auf Cold Mails)
model EmailMessage {
  id          String   @id @default(cuid())
  instantlyId String?  @unique
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign    String?
  direction   String   @default("IN") // IN = Antwort vom Kontakt, OUT = von uns
  subject     String?
  text        String?
  html        String?
  fromEmail   String?
  threadId    String?
  isAutoReply Boolean  @default(false)
  sentiment   String? // POSITIV, NEGATIV, NEUTRAL
  sentAt      DateTime
  createdAt   DateTime @default(now())

  @@index([contactId, sentAt])
}

// Rohdaten aus Waalaxy (Webhook), auch nicht zugeordnete – zum Nachvollziehen
model LinkedInEvent {
  id        String   @id @default(cuid())
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source    String // webhook | csv
  name      String?
  company   String?
  url       String?
  status    String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([createdAt])
}

// Termine aus Calendly (gebucht über Calendly → Google Calendar)
model Meeting {
  id           String    @id @default(cuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  calendlyUri  String?   @unique // Invitee-URI
  eventUri     String?
  title        String
  startAt      DateTime
  endAt        DateTime?
  location     String?
  joinUrl      String?
  status       String    @default("GEPLANT") // GEPLANT, ABGESAGT, VERSCHOBEN
  cancelReason String?
  canceledBy   String?
  rescheduleUrl String?
  cancelUrl    String?
  answers      String? // Fragen & Antworten aus dem Buchungsformular
  utmSource    String?
  inviteeName  String?
  inviteeEmail String?
  taskId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([contactId])
  @@index([startAt])
}
